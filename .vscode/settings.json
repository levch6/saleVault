{
  // Only facts about the project here; personal preferences belong in user settings.
  "editor.formatOnSave": true,

  // Python: ruff formats and fixes like the hooks; mypy reports type errors (Pylance only
  // completes, so its checks do not contradict `mypy --strict`). Tools come from backend/.venv.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.analysis.typeCheckingMode": "off",
  "ruff.importStrategy": "fromEnvironment",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.cwd": "${workspaceFolder}/backend",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  // Tests run from backend/, where pytest deselects the live tests (`-m "not live"`).
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  // Frontend: Biome lives in frontend/, not at the repository root, so point the extension at
  // its config and at the project's binary (the extension resolves the pnpm shim itself).
  // Relative to the repository root: the released extension does not expand ${workspaceFolder}.
  "biome.configurationPath": "frontend/biome.json",
  "biome.lsp.bin": "frontend/node_modules/.bin/biome",
  "[typescript][typescriptreact][javascript][json][jsonc][css]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },

  // TypeScript 7 has no JavaScript language service: use its native one, from the project.
  // VS Code asks once whether to trust and use that version.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "frontend/node_modules/typescript",
  "js/ts.enablePromptUseWorkspaceTsdk": true,

  // Generated files: regenerate them (`just gen-api`, the router plugin), never edit by hand.
  "files.readonlyInclude": {
    "frontend/src/routeTree.gen.ts": true,
    "frontend/src/api/schema.d.ts": true
  }
}

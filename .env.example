# Copy to .env (never committed) and uncomment what you want to change. Every variable is
# optional; see docs/reference/configuration.md.

# SALEVAULT_DATA_DIR=/path/to/data
# SALEVAULT_FRONTEND_DIST=/path/to/frontend/dist
# SALEVAULT_HOST=127.0.0.1
# SALEVAULT_PORT=8000
# SALEVAULT_ALLOWED_HOSTS=["localhost", "127.0.0.1"]

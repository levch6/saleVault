# Local-only working notes: plan, research, archived specs and ADRs (never pushed)
/.notes/

# Runtime data: DB, browser profile, logs, raw dumps, backups
/data/

# Data-shaped files outside data/ (exports, database copies, raw dumps)
*.jsonl
*.json.gz
*.db
*.db-wal
*.db-shm
*.sqlite*

# Secrets / local config
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# Git worktrees of coding agents
/.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
/backend/htmlcov/
*.egg-info/
/backend/build/
/backend/dist/

# Node / frontend
node_modules/
/frontend/dist/
*.tsbuildinfo
.vite/
/frontend/coverage/

# Tooling output
.playwright-mcp/
playwright-report/
test-results/
*.log

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*:Zone.Identifier
